G2B_SERVICE_KEY=
DATABASE_URL=

# 상세 큐는 운영 전환 승인과 0014~0017 스키마 적용을 마친 뒤 활성화합니다.
DETAIL_COLLECTION_QUEUE_ENABLED=false

# 0018·0019 적용 후 검증 환경에서만 사용합니다. 운영 활성화는 단계별 결과 확인 이후입니다.
DETAIL_PDF_REGISTRATION_ENABLED=false

# 0020 적용 후 공통 실행 요청을 허용합니다. 웹은 별도 플래그도 필요합니다.
PDF_PROGRESS_DISPATCH_ENABLED=false
G2B_PDF_EXTRACTION_ENABLED=false
PDF_DISPATCH_REPOSITORY=
PDF_DISPATCH_TOKEN=
PDF_WEB_DISPATCH_ENABLED=false


# 운영 대기열 로컬 작업기는 기본 비활성화합니다.
PDF_WORKER_ENABLED=false
PDF_WORKER_URL=http://127.0.0.1:8788
PDF_WORKER_TOKEN=

# 로컬 관리자에서 운영 대기열·파일별 조회를 사용합니다. production에서는 항상 차단합니다.
PDF_EXTRACTION_ENABLED=false

# 외부 PDF 보완 실행을 비활성으로 등록할 때만 로컬에서 사용합니다. 브라우저로 보내지 않습니다.
CRON_JOB_API_KEY=
PDF_GITHUB_TOKEN=
